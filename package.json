{
  "name": "jewelry-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12.0 <27" },
  "scripts": {
    "dev": "concurrently -k -n next,worker -c blue,magenta \"next dev -p 3123\" \"tsx watch worker/main.ts\"",
    "dev:next": "next dev -p 3123",
    "dev:worker": "tsx watch worker/main.ts",
    "build": "next build && tsc -p worker/tsconfig.json && node scripts/postbuild.mjs",
    "start": "concurrently -k -n next,worker -c blue,magenta \"node .next/standalone/server.js\" \"tsx worker/main.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@derhuerst/ffprobe-static": "5.3.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.104.2",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "ffmpeg-static": "5.3.0",
    "konva": "10.8.0",
    "lucide-react": "1.57.0",
    "media-chrome": "4.19.3",
    "motion": "14.2.0",
    "nanoid": "6.0.2",
    "next": "16.4.0",
    "p-limit": "7.3.3",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-compare-slider": "4.0.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-konva": "19.3.0",
    "react-virtuoso": "4.18.19",
    "react-zoom-pan-pinch": "4.2.0",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
