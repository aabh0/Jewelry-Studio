# ---- Lane A: Higgsfield Cloud API (required for generation) ----
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# ---- Lane B: Higgsfield consumer CLI (optional; spends your Pro plan credits) ----
# Install: npm i -g @higgsfield/cli@1.1.26  then run: higgsfield auth login
# Leave empty to auto-detect on PATH.
HIGGSFIELD_CLI_PATH=

# ---- Anthropic (required for storyboards, prompt assist and QA) ----
ANTHROPIC_API_KEY=
CLAUDE_DIRECTOR_MODEL=claude-opus-5-5
CLAUDE_QA_MODEL=claude-haiku-5-5

# ---- Storage ----
# Default: ~/JewelryStudio (macOS/Linux) or %USERPROFILE%\JewelryStudio (Windows)
DATA_DIR=

# ---- Binaries (optional overrides; ffmpeg-static is used when empty) ----
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Worker ----
WORKER_CONCURRENCY_PROVIDER=4
WORKER_CONCURRENCY_FFMPEG=1
WORKER_CONCURRENCY_CLAUDE=3
DAILY_SPEND_CAP_USD=50

# ---- Server ----
PORT=3123
HOST=127.0.0.1

# ---- Testing: 1 = swap every provider for deterministic fixtures ----
MOCK_PROVIDERS=0
# Simulated per-output latency in mock mode (ms); the resume test sets 5000
MOCK_LATENCY_MS=150
